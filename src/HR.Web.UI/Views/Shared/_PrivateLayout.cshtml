<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | HR &amp; Recruitment</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="d-flex">
        <aside class="sidebar d-flex flex-column p-3">
            <a asp-controller="Dashboard" asp-action="Index" class="brand mb-3">HR &amp; Recruitment</a>
            <nav class="nav flex-column flex-grow-1">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employees" ? "active" : "")" asp-controller="Employees" asp-action="Index">Employees</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Departments" ? "active" : "")" asp-controller="Departments" asp-action="Index">Departments</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Designations" ? "active" : "")" asp-controller="Designations" asp-action="Index">Designations</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Jobs" ? "active" : "")" asp-controller="Jobs" asp-action="Index">Job openings</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Candidates" ? "active" : "")" asp-controller="Candidates" asp-action="Index">Candidates</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Applications" ? "active" : "")" asp-controller="Applications" asp-action="Index">Applications</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Interviews" ? "active" : "")" asp-controller="Interviews" asp-action="Index">Interviews</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Offers" ? "active" : "")" asp-controller="Offers" asp-action="Index">Offers</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Employee)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leaves" ? "active" : "")" asp-controller="Leaves" asp-action="Index">Leave requests</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "LeaveTypes" ? "active" : "")" asp-controller="LeaveTypes" asp-action="Index">Leave types</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Employee)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")" asp-controller="Attendance" asp-action="Index">Attendance</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Employee)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payroll" ? "active" : "")" asp-controller="Payroll" asp-action="Index">Payroll</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Employee)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active" : "")" asp-controller="Reviews" asp-action="Index">Reviews</a> }
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
            {
                <div class="nav-group">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Registers" ? "active" : "")" href="#" onclick="return false;">Registers <span class="float-end">&#9656;</span></a>
                    <div class="submenu">
                        <a asp-controller="Registers" asp-action="Index">All registers and forms</a>
                        <div class="submenu-title">Registers</div>
                        <a asp-controller="Registers" asp-action="EmployeeRegister">Employee Register</a>
                        <a asp-controller="Registers" asp-action="LeaveRegister">Leave Register</a>
                        <a asp-controller="Registers" asp-action="AttendanceRegister">Daily Attendance Register</a>
                        <a asp-controller="Registers" asp-action="WagesRegister">Wages and Payslip Register</a>
                        <div class="submenu-title">Letters</div>
                        <a asp-controller="Registers" asp-action="AppointmentLetter">Appointment Letter</a>
                    </div>
                </div>
            }
            @if (User.IsInRole(RoleNames.Admin)) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">Users</a> }
            </nav>
            <div class="small text-white-50 mb-2">@User.Identity?.Name</div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button class="btn btn-sm btn-outline-light w-100">Logout</button>
            </form>
        </aside>
        <main class="flex-grow-1 p-4">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
