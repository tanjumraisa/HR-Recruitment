@model UserEditViewModel
@{
    ViewData["Title"] = "Edit user";
}
<div class="row justify-content-center"><div class="col-lg-6"><div class="card"><div class="card-body">
    <h4 class="mb-1">@Model.FullName</h4>
    <p class="text-muted">@Model.Email</p>
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="UserId" /><input type="hidden" asp-for="FullName" /><input type="hidden" asp-for="Email" />
        <div class="mb-3"><label asp-for="RoleId" class="form-label"></label><select asp-for="RoleId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Roles)"></select></div>
        <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>
        <button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div></div></div></div>
