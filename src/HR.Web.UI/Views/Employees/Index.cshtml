@using HR.Entities
@model List<Employee>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Employees</h4>
    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Code</th><th>Name</th><th>Department</th><th>Designation</th><th>Manager</th><th>Joined</th><th>Salary</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.EmployeeCode</td><td>@x.User.FullName</td><td>@x.Department.Name</td><td>@x.Designation.Title</td><td>@(x.Manager?.EmployeeCode ?? "-")</td><td>@x.JoinDate.ToString("yyyy-MM-dd")</td><td>@x.Salary.ToString("N2")</td><td><span class="badge bg-secondary">@x.Status</span></td>
                        <td class="text-end text-nowrap">
                        
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Edit" asp-route-id="@x.EmployeeId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            }
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Delete" asp-route-id="@x.EmployeeId" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
