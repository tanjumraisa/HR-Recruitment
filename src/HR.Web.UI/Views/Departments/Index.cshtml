@using HR.Entities
@model List<Department>
@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Departments</h4>
    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Name</th><th>Description</th><th>Active</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Name</td><td>@x.Description</td><td>@(x.IsActive ? "Yes" : "No")</td>
                        <td class="text-end text-nowrap">
                        
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Edit" asp-route-id="@x.DepartmentId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            }
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Delete" asp-route-id="@x.DepartmentId" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
