@using HR.Entities
@model JobOpening
@{
    var isNew = Model.JobOpeningId == 0;
    ViewData["Title"] = (isNew ? "Add " : "Edit ") + "job opening";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h4 class="mb-3">@ViewData["Title"]</h4>
                <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    @if (!isNew)
                    {
                        <input type="hidden" asp-for="JobOpeningId" />
                    }
                    <div class="row g-3">
            <div class="col-md-6"><label asp-for="Title" class="form-label">Job title</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="DepartmentId" class="form-label">Department</label><select asp-for="DepartmentId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Departments)"><option value="">-- Select --</option></select><span asp-validation-for="DepartmentId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="DesignationId" class="form-label">Designation</label><select asp-for="DesignationId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Designations)"><option value="">-- Select --</option></select><span asp-validation-for="DesignationId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Vacancies" class="form-label">Vacancies</label><input asp-for="Vacancies" class="form-control" /><span asp-validation-for="Vacancies" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="EmploymentType" class="form-label">Employment type</label><select asp-for="EmploymentType" class="form-select" asp-items="@(new SelectList(new[] { "Full-time", "Part-time", "Contract", "Internship" }))"></select><span asp-validation-for="EmploymentType" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Deadline" class="form-label">Application deadline</label><input asp-for="Deadline" type="date" class="form-control" /><span asp-validation-for="Deadline" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="SalaryMin" class="form-label">Salary min</label><input asp-for="SalaryMin" class="form-control" step="0.01" /><span asp-validation-for="SalaryMin" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="SalaryMax" class="form-label">Salary max</label><input asp-for="SalaryMax" class="form-control" step="0.01" /><span asp-validation-for="SalaryMax" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select" asp-items="@(new SelectList(JobStatus.All))"></select><span asp-validation-for="Status" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Requirements" class="form-label">Requirements</label><textarea asp-for="Requirements" class="form-control" rows="3"></textarea><span asp-validation-for="Requirements" class="text-danger"></span></div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
