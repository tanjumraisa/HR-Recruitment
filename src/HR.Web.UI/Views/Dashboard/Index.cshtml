@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<h4 class="mb-3">Welcome, @User.Identity?.Name</h4>

@if (User.IsInRole(RoleNames.Employee))
{
    <div class="row g-3">
        <div class="col-md-3"><a asp-controller="Attendance" asp-action="Index" class="btn btn-outline-primary w-100">My attendance</a></div>
        <div class="col-md-3"><a asp-controller="Leaves" asp-action="Index" class="btn btn-outline-primary w-100">My leaves</a></div>
        <div class="col-md-3"><a asp-controller="Payroll" asp-action="Index" class="btn btn-outline-primary w-100">My payslips</a></div>
        <div class="col-md-3"><a asp-controller="Reviews" asp-action="Index" class="btn btn-outline-primary w-100">My reviews</a></div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Active employees</div><div class="value">@Model.TotalEmployees</div></div></div></div>
        <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Open jobs</div><div class="value">@Model.OpenJobs</div></div></div></div>
        <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Applications</div><div class="value">@Model.TotalApplications</div></div></div></div>
        @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
        {
            <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Pending leaves</div><div class="value">@Model.PendingLeaves</div></div></div></div>
        }
    </div>

    <div class="row g-3">
        <div class="col-md-5">
            <div class="card"><div class="card-body">
                <h6>Hiring pipeline</h6>
                <ul class="list-group list-group-flush">
                    @foreach (var s in Model.ApplicationsByStatus)
                    {
                        <li class="list-group-item d-flex justify-content-between">@s.Key <span class="badge bg-primary">@s.Value</span></li>
                    }
                </ul>
            </div></div>
        </div>
        <div class="col-md-7">
            <div class="card"><div class="card-body">
                <h6>Recent applications</h6>
                <table class="table table-sm mb-0">
                    <tbody>
                    @foreach (var a in Model.RecentApplications)
                    {
                        <tr><td>@a.Candidate.FullName</td><td>@a.JobOpening.Title</td><td><span class="badge bg-secondary">@a.Status</span></td>
                            <td><a asp-controller="Applications" asp-action="Details" asp-route-id="@a.ApplicationId">Open</a></td></tr>
                    }
                    </tbody>
                </table>
            </div></div>
        </div>
    </div>
}
