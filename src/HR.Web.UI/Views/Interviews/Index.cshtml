@using HR.Entities
@model List<Interview>
@{
    ViewData["Title"] = "Interviews";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Interviews</h4>
    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Candidate</th><th>Job</th><th>Interviewer</th><th>When</th><th>Mode</th><th>Score</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Application.Candidate.FullName</td><td>@x.Application.JobOpening.Title</td><td>@x.Interviewer.User.FullName</td><td>@x.ScheduledAt.ToString("yyyy-MM-dd HH:mm")</td><td>@x.Mode</td><td>@(x.Score?.ToString() ?? "-")</td><td><span class="badge bg-secondary">@x.Status</span></td>
                        <td class="text-end text-nowrap">
                        
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter))
                            {
                                <a asp-action="Edit" asp-route-id="@x.InterviewId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            }
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Delete" asp-route-id="@x.InterviewId" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
