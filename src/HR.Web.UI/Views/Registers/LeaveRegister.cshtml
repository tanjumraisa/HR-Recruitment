@using HR.Entities
@model List<LeaveRequest>
@{
    var from = (DateTime)ViewBag.From; var to = (DateTime)ViewBag.To;
    ViewData["Title"] = "Leave Register";
    ViewData["Subtitle"] = "From " + from.ToString("dd/MM/yyyy") + " to " + to.ToString("dd/MM/yyyy");
}
<form method="get" class="no-print row g-2 align-items-end mb-3">
    <div class="col-auto"><label class="form-label mb-0">From</label><input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-auto"><label class="form-label mb-0">To</label><input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Show</button> <button type="button" onclick="window.print()" class="btn btn-primary">Print / Save as PDF</button></div>
</form>
<div class="register-sheet">
    <partial name="_RegisterHeader" />
    <table class="table table-sm mb-0">
        <thead><tr><th>#</th><th>Code</th><th>Name</th><th>Leave type</th><th>From</th><th>To</th><th>Days</th><th>Status</th><th>Decided by</th></tr></thead>
        <tbody>
        @{ var i = 1; }
        @foreach (var l in Model)
        {
            <tr><td>@(i++)</td><td>@l.Employee.EmployeeCode</td><td>@l.Employee.User.FullName</td><td>@l.LeaveType.Name</td>
                <td>@l.FromDate.ToString("dd/MM/yyyy")</td><td>@l.ToDate.ToString("dd/MM/yyyy")</td><td>@l.TotalDays</td><td>@l.Status</td>
                <td>@(l.ApprovedBy?.User.FullName ?? "-")</td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="9" class="text-center text-muted">No leave in this period.</td></tr> }
        </tbody>
    </table>
    <partial name="_RegisterFooter" />
</div>
