<Project>
  <PropertyGroup>
    <!-- Smart App Control blocks unsigned .exe files; run through dotnet.exe instead -->
    <UseAppHost>false</UseAppHost>
    <!-- Known-vulnerability warnings from transitive EF Core packages (do not stop the build) -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>
</Project>
