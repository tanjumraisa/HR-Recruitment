<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseAppHost>false</UseAppHost>
		<NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Library\HR.Entities\HR.Entities.csproj" />
		<ProjectReference Include="..\..\Business\HR.Facade\HR.Facade.csproj" />
		<ProjectReference Include="..\..\Library\HR.Framework\HR.Framework.csproj" />
		<ProjectReference Include="..\..\Library\HR.Integration\HR.Integration.csproj" />
	</ItemGroup>

</Project>