@using HR.Entities
@model List<JobOpening>
@{
    ViewData["Title"] = "Careers";
    Layout = "_PublicLayout";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Open positions</h3>
    <form method="get" class="d-flex gap-2">
        <input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search title or department" />
        <button class="btn btn-primary">Search</button>
    </form>
</div>
<div class="row g-3">
    @foreach (var j in Model)
    {
        <div class="col-md-6">
            <div class="card h-100"><div class="card-body">
                <h5>@j.Title</h5>
                <div class="text-muted mb-2">@j.Department.Name &middot; @j.EmploymentType &middot; @j.Vacancies vacancy(ies)</div>
                <div class="small mb-3">Apply before <strong>@j.Deadline.ToString("dd MMM yyyy")</strong></div>
                <a asp-action="Details" asp-route-id="@j.JobOpeningId" class="btn btn-outline-primary btn-sm">View details</a>
            </div></div>
        </div>
    }
    @if (!Model.Any())
    {
        <p class="text-muted">No open positions right now. Please check again later.</p>
    }
</div>
