@model List<HR.Entities.Notification>
@{
    ViewData["Title"] = "Notifications";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Notifications</h4>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllRead" method="post"><button class="btn btn-sm btn-outline-secondary">Mark all as read</button></form>
    }
</div>
<div class="list-group">
    @foreach (var n in Model)
    {
        <a href="/Notifications/Open/@n.NotificationId" class="list-group-item list-group-item-action @(n.IsRead ? "" : "fw-semibold bg-light")">
            <div class="d-flex justify-content-between"><span>@n.Title</span><small class="text-muted">@n.CreatedAt.ToString("dd MMM yyyy HH:mm")</small></div>
            <div class="small text-muted">@n.Message</div>
        </a>
    }
    @if (!Model.Any()) { <div class="list-group-item text-muted">No notifications.</div> }
</div>
