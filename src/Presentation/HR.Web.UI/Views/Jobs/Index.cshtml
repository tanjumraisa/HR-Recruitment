@using HR.Entities
@model List<JobOpening>
@{
    ViewData["Title"] = "Job openings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Job openings</h4>
    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Title</th><th>Department</th><th>Vacancies</th><th>Salary range</th><th>Deadline</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Title</td><td>@x.Department.Name</td><td>@x.Vacancies</td><td>@x.SalaryMin.ToString("N0") - @x.SalaryMax.ToString("N0")</td><td>@x.Deadline.ToString("yyyy-MM-dd")</td><td><span class="badge bg-secondary">@x.Status</span></td>
                        <td class="text-end text-nowrap">
                            @if (!User.IsInRole(RoleNames.Employee)) { <a href="/records/JobOpening/@x.JobOpeningId" class="btn btn-sm btn-outline-primary" title="Open with all connected records">View</a> }
                        
                        @if (x.Status != JobStatus.Open)
                        {
                            <form asp-action="SetStatus" method="post" class="d-inline"><input type="hidden" name="id" value="@x.JobOpeningId" /><input type="hidden" name="status" value="Open" /><button class="btn btn-sm btn-outline-success">Publish</button></form>
                        }
                        @if (x.Status == JobStatus.Open)
                        {
                            <form asp-action="SetStatus" method="post" class="d-inline"><input type="hidden" name="id" value="@x.JobOpeningId" /><input type="hidden" name="status" value="Closed" /><button class="btn btn-sm btn-outline-warning">Close</button></form>
                        }
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter))
                            {
                                <a asp-action="Edit" asp-route-id="@x.JobOpeningId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            }
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Delete" asp-route-id="@x.JobOpeningId" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
