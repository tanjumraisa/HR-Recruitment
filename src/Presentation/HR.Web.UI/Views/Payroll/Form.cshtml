@using HR.Entities
@model Payroll
@{
    var isNew = Model.PayrollId == 0;
    ViewData["Title"] = (isNew ? "Add " : "Edit ") + "payroll record";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h4 class="mb-3">@ViewData["Title"]</h4>
                <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    @if (!isNew)
                    {
                        <input type="hidden" asp-for="PayrollId" />
                    }
                    <div class="row g-3">
            <div class="col-md-6"><label asp-for="EmployeeId" class="form-label">Employee</label><select asp-for="EmployeeId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Employees)"><option value="">-- Select --</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Month" class="form-label">Month (1-12)</label><input asp-for="Month" class="form-control" /><span asp-validation-for="Month" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Year" class="form-label">Year</label><input asp-for="Year" class="form-control" /><span asp-validation-for="Year" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="BasicSalary" class="form-label">Basic salary</label><input asp-for="BasicSalary" class="form-control" step="0.01" /><span asp-validation-for="BasicSalary" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Allowance" class="form-label">Allowance</label><input asp-for="Allowance" class="form-control" step="0.01" /><span asp-validation-for="Allowance" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Deduction" class="form-label">Deduction</label><input asp-for="Deduction" class="form-control" step="0.01" /><span asp-validation-for="Deduction" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select" asp-items="@(new SelectList(PayrollStatus.All))"></select><span asp-validation-for="Status" class="text-danger"></span></div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
