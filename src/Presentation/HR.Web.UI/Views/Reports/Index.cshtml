@model IReadOnlyList<HR.Facade.Interface.ReportInfo>
@{
    ViewData["Title"] = "All reports";
}
<h4 class="mb-3">All reports</h4>
<div class="row g-3">
    @foreach (var r in Model)
    {
        <div class="col-md-6 col-xl-4">
            <a href="/Reports/Show/@r.Key" class="card h-100 text-decoration-none report-card">
                <div class="card-body">
                    <div class="fw-semibold text-dark">@r.Title</div>
                    <div class="small text-muted">@r.Description</div>
                </div>
            </a>
        </div>
    }
</div>
