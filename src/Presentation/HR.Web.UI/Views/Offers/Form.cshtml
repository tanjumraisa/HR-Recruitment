@using HR.Entities
@model OfferLetter
@{
    var isNew = Model.OfferId == 0;
    ViewData["Title"] = (isNew ? "Add " : "Edit ") + "offer";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h4 class="mb-3">@ViewData["Title"]</h4>
                <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    @if (!isNew)
                    {
                        <input type="hidden" asp-for="OfferId" />
                    }
                    <div class="row g-3">
            <div class="col-md-6"><label asp-for="ApplicationId" class="form-label">Application (interviewed)</label><select asp-for="ApplicationId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Applications)"><option value="">-- Select --</option></select><span asp-validation-for="ApplicationId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="OfferedSalary" class="form-label">Offered salary</label><input asp-for="OfferedSalary" class="form-control" step="0.01" /><span asp-validation-for="OfferedSalary" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="JoiningDate" class="form-label">Joining date</label><input asp-for="JoiningDate" type="date" class="form-control" /><span asp-validation-for="JoiningDate" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select" asp-items="@(new SelectList(OfferStatus.All))"></select><span asp-validation-for="Status" class="text-danger"></span></div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
