@using HR.Entities
@model List<OfferLetter>
@{
    ViewData["Title"] = "Offer letters";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Offer letters</h4>
    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Candidate</th><th>Job</th><th>Salary</th><th>Joining</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Application.Candidate.FullName</td><td>@x.Application.JobOpening.Title</td><td>@x.OfferedSalary.ToString("N2")</td><td>@x.JoiningDate.ToString("yyyy-MM-dd")</td><td><span class="badge bg-secondary">@x.Status</span></td>
                        <td class="text-end text-nowrap">
                            @if (!User.IsInRole(RoleNames.Employee)) { <a href="/records/OfferLetter/@x.OfferId" class="btn btn-sm btn-outline-primary" title="Open with all connected records">View</a> }
                        
                        @if (x.Status == OfferStatus.Issued && (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager)))
                        {
                            <form asp-action="Respond" method="post" class="d-inline"><input type="hidden" name="id" value="@x.OfferId" /><input type="hidden" name="accept" value="true" /><button class="btn btn-sm btn-outline-success">Accepted</button></form>
                            <form asp-action="Respond" method="post" class="d-inline"><input type="hidden" name="id" value="@x.OfferId" /><input type="hidden" name="accept" value="false" /><button class="btn btn-sm btn-outline-danger">Declined</button></form>
                        }
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Edit" asp-route-id="@x.OfferId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            }
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Delete" asp-route-id="@x.OfferId" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
