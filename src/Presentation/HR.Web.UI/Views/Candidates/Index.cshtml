@using HR.Entities
@model List<Candidate>
@{
    ViewData["Title"] = "Candidates";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Candidates</h4>
    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Experience</th><th>Skills</th><th>CV</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.FullName</td><td>@x.Email</td><td>@x.Phone</td><td>@x.ExperienceYears yr</td><td>@x.Skills</td><td>@if (x.ResumeFileName != null) { <a asp-controller="Resumes" asp-action="Download" asp-route-id="@x.CandidateId">Download</a> } else { <span class="text-muted">-</span> }</td>
                        <td class="text-end text-nowrap">
                            @if (!User.IsInRole(RoleNames.Employee)) { <a href="/records/Candidate/@x.CandidateId" class="btn btn-sm btn-outline-primary" title="Open with all connected records">View</a> }
                        
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager) || User.IsInRole(RoleNames.Recruiter))
                            {
                                <a asp-action="Edit" asp-route-id="@x.CandidateId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            }
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Delete" asp-route-id="@x.CandidateId" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
