@using HR.Entities
@model PerformanceReview
@{
    var isNew = Model.ReviewId == 0;
    ViewData["Title"] = (isNew ? "Add " : "Edit ") + "review";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h4 class="mb-3">@ViewData["Title"]</h4>
                <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    @if (!isNew)
                    {
                        <input type="hidden" asp-for="ReviewId" />
                    }
                    <div class="row g-3">
            <div class="col-md-6"><label asp-for="EmployeeId" class="form-label">Employee</label><select asp-for="EmployeeId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Employees)"><option value="">-- Select --</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="ReviewerId" class="form-label">Reviewer</label><select asp-for="ReviewerId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Employees)"><option value="">-- Select --</option></select><span asp-validation-for="ReviewerId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Period" class="form-label">Period (e.g. 2026-H1)</label><input asp-for="Period" class="form-control" /><span asp-validation-for="Period" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Rating" class="form-label">Rating (1-5)</label><input asp-for="Rating" class="form-control" /><span asp-validation-for="Rating" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Comments" class="form-label">Comments</label><textarea asp-for="Comments" class="form-control" rows="3"></textarea><span asp-validation-for="Comments" class="text-danger"></span></div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
