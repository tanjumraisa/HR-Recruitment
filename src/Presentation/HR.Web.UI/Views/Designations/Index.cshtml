@using HR.Entities
@model List<Designation>
@{
    ViewData["Title"] = "Designations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Designations</h4>
    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Title</th><th>Base salary</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Title</td><td>@x.BaseSalary.ToString("N2")</td>
                        <td class="text-end text-nowrap">
                            @if (!User.IsInRole(RoleNames.Employee)) { <a href="/records/Designation/@x.DesignationId" class="btn btn-sm btn-outline-primary" title="Open with all connected records">View</a> }
                        
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Edit" asp-route-id="@x.DesignationId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            }
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Delete" asp-route-id="@x.DesignationId" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
