@using HR.Web.UI.Helpers
@model CrudFormViewModel
@{
    var title = (Model.IsNew ? "Add " : "Edit ") + EntityMeta.Words(Model.Meta.Type.Name).ToLower();
    ViewData["Title"] = title;
    var id = Model.Meta.KeyOf(Model.Entity);
    string? Error(string name) => ViewData.ModelState.TryGetValue(name, out var s) && s.Errors.Count > 0 ? s.Errors[0].ErrorMessage : null;
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h4 class="mb-0">@title</h4>
                        <div class="text-muted small mb-3">@Model.Module?.Title</div>
                    </div>
                    @if (!Model.IsNew) { <a href="/records/@Model.Meta.Type.Name/@id" class="btn btn-sm btn-outline-primary">View connected records</a> }
                </div>
                <form method="post" asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@(Model.IsNew ? (int?)null : id)" onsubmit="var b=this.querySelector('button[type=submit]'); b.disabled=true; b.innerText='Saving...';">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    @if (!Model.IsNew) { <input type="hidden" name="@Model.Meta.Key.Name" value="@id" /> }
                    <div class="row g-3">
                        @foreach (var f in Model.Meta.Fields)
                        {
                            var value = EntityMeta.InputValue(f, Model.Entity);
                            var err = Error(f.Name);
                            var invalid = err != null ? " is-invalid" : "";
                            var star = f.Required ? " *" : "";
                            if (f.Kind == FieldKind.Bool)
                            {
                                <div class="col-md-6">
                                    <div class="form-check mt-4">
                                        <input type="checkbox" class="form-check-input" id="@f.Name" name="@f.Name" value="true" checked="@(f.Prop.GetValue(Model.Entity) is true)" />
                                        <input type="hidden" name="@f.Name" value="false" />
                                        <label class="form-check-label" for="@f.Name">@f.Label</label>
                                    </div>
                                </div>
                                continue;
                            }
                            <div class="@(f.Kind == FieldKind.TextArea ? "col-12" : "col-md-6")">
                                <label class="form-label" for="@f.Name">@f.Label<span class="text-danger">@star</span></label>
                                @switch (f.Kind)
                                {
                                    case FieldKind.ForeignKey:
                                        <select id="@f.Name" name="@f.Name" class="form-select@(invalid)" required="@f.Required">
                                            <option value="">-- Select --</option>
                                            @foreach (var o in Model.Lookups[f.Name].OrderBy(o => o.Value))
                                            {
                                                <option value="@o.Key" selected="@(value == o.Key.ToString())">@o.Value</option>
                                            }
                                        </select>
                                        break;
                                    case FieldKind.Choice:
                                        <select id="@f.Name" name="@f.Name" class="form-select@(invalid)">
                                            @foreach (var c in f.Choices) { <option value="@c" selected="@(value == c)">@EntityMeta.Words(c)</option> }
                                        </select>
                                        break;
                                    case FieldKind.TextArea:
                                        <textarea id="@f.Name" name="@f.Name" class="form-control@(invalid)" rows="3" maxlength="@f.MaxLength">@value</textarea>
                                        break;
                                    case FieldKind.Int:
                                        <input id="@f.Name" name="@f.Name" type="number" step="1" min="@f.Min" max="@f.Max" value="@value" class="form-control@(invalid)" required="@(!f.Nullable)" />
                                        break;
                                    case FieldKind.Decimal:
                                        <input id="@f.Name" name="@f.Name" type="number" step="0.01" min="@f.Min" max="@f.Max" value="@value" class="form-control@(invalid)" required="@(!f.Nullable)" />
                                        break;
                                    case FieldKind.Date:
                                        <input id="@f.Name" name="@f.Name" type="date" value="@value" class="form-control@(invalid)" required="@(!f.Nullable)" />
                                        break;
                                    case FieldKind.DateTime:
                                        <input id="@f.Name" name="@f.Name" type="datetime-local" value="@value" class="form-control@(invalid)" required="@(!f.Nullable)" />
                                        break;
                                    case FieldKind.Time:
                                        <input id="@f.Name" name="@f.Name" type="time" value="@value" class="form-control@(invalid)" required="@(!f.Nullable)" />
                                        break;
                                    default:
                                        <input id="@f.Name" name="@f.Name" type="text" value="@value" maxlength="@f.MaxLength" class="form-control@(invalid)" required="@f.Required" />
                                        break;
                                }
                                @if (err != null) { <div class="invalid-feedback">@err</div> }
                            </div>
                        }
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a href="@(string.IsNullOrEmpty(Model.ReturnUrl) ? Url.Action("Index") : Model.ReturnUrl)" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
