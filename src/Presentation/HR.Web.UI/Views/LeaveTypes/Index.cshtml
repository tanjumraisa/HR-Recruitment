@using HR.Entities
@model List<LeaveType>
@{
    ViewData["Title"] = "Leave types";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Leave types</h4>
    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Name</th><th>Days per year</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Name</td><td>@x.DaysPerYear</td>
                        <td class="text-end text-nowrap">
                            @if (!User.IsInRole(RoleNames.Employee)) { <a href="/records/LeaveType/@x.LeaveTypeId" class="btn btn-sm btn-outline-primary" title="Open with all connected records">View</a> }
                        
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Edit" asp-route-id="@x.LeaveTypeId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            }
                            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HRManager))
                            {
                                <a asp-action="Delete" asp-route-id="@x.LeaveTypeId" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
